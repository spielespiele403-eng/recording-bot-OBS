# Server
PORT=3000
NODE_ENV=development
# Publicly reachable base URL for this server (ngrok URL in dev, real domain in prod).
# Vapi / Twilio / Cal.com webhooks are configured to call back to this URL.
PUBLIC_BASE_URL=https://your-tunnel-or-domain.example.com

# Database (SQLite by default; swap to a Postgres URL later without schema changes)
DATABASE_URL="file:./dev.db"

# Vapi (voice AI platform) - https://dashboard.vapi.ai
VAPI_API_KEY=
# Shared secret you set on the Vapi assistant's server config; used to verify webhook calls.
VAPI_WEBHOOK_SECRET=

# Twilio (SMS missed-call recovery) - https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+10000000000

# Note: Cal.com API keys are stored per-Business in the database (multi-tenant),
# not as a global env var here - see prisma/seed.ts for the demo business.
