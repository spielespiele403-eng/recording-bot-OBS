{
  "manifest_version": 3,
  "name": "YouTube Boost – Smart Recommendations",
  "version": "1.0.0",
  "description": "Bessere YouTube-Empfehlungen, ein Watch-Time-Tracker und ein eingebauter Playlist-Manager – direkt im Browser.",
  "default_locale": "de",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "YouTube Boost"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "dashboard/dashboard.html"
}
